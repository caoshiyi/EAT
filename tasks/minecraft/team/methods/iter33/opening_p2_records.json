 if(['dirt','cobblestone','spruce_planks'].reduce((n,name)=>n+bot.inventory.items().filter(i=>i.name===name).reduce((s,i)=>s+i.count,0),0)<10)throw Error('portable ending funding not retained');
}
async function finishShelter(){
