const V=bot.entity.position.constructor,v=(x,y,z)=>new V(x,y,z),wait=n=>bot.waitForTicks(n);
const state=()=>({at:new Date().toISOString(),p:bot.entity.position.clone(),hp:bot.health,food:bot.food,dim:bot.game.dimension,ground:bot.entity.onGround,inv:bot.inventory.items().map(i=>[i.name,i.count,i.durabilityUsed])});
const full=q=>bot.blockAt(q)?.shapes?.some(s=>s.join(',')==='0,0,0,1,1,1');
const dirs=[v(0,-1,0),v(0,1,0),v(0,0,-1),v(0,0,1),v(-1,0,0),v(1,0,0)];
async function face(q){
 const eye=bot.entity.position.offset(0,bot.entity.eyeHeight,0),block=bot.blockAt(q),points=[q.offset(.5,.5,.5)];let obstruction=null;
 for(const sh of block?.shapes||[])for(const axis of[0,1,2])for(const end of[0,1])for(const u of[.01,.25,.5,.75,.99])for(const w of[.01,.25,.5,.75,.99]){const co=[0,0,0],others=[0,1,2].filter(x=>x!==axis);co[axis]=sh[axis+3*end]+(end?-.001:.001);co[others[0]]=sh[others[0]]+(sh[others[0]+3]-sh[others[0]])*u;co[others[1]]=sh[others[1]]+(sh[others[1]+3]-sh[others[1]])*w;points.push(q.offset(...co));}
 for(const aim of points){const d=aim.minus(eye),dist=d.norm();if(dist>4.4||dist<.001)continue;const h=bot.world.raycast(eye,d.scaled(1/dist),dist+.02);if(!h?.position.equals(q)){if(h)obstruction={p:h.position,n:bot.blockAt(h.position)?.name};continue;}await bot.lookAt(aim,true);await wait(1);const c=bot.blockAtCursor(4.5);if(c?.position.equals(q))return c;}
 throw Error('no visible reachable face '+q+' obstruction '+JSON.stringify(obstruction));
}
async function cut(q){const b=bot.blockAt(q);if(['air','cave_air'].includes(b?.name))return;if(['water','lava','obsidian','chest','crafting_table','nether_portal'].includes(b?.name)||b?.name?.endsWith('_bed'))throw Error('protected '+b?.name);if(b.name==='snow'&&!b.shapes.length){const shovel=bot.inventory.items().find(i=>i.name==='stone_shovel')||bot.inventory.items().find(i=>i.name.endsWith('_shovel'));if(!shovel)throw Error('snow shovel absent');await bot.equip(shovel,'hand');const eye=bot.entity.position.offset(0,bot.entity.eyeHeight,0),aim=q.offset(.5,.1,.5),d=aim.minus(eye),h=bot.world.raycast(eye,d.scaled(1/d.norm()),d.norm()+.01);if(d.norm()>4.4||(h&&!h.position.equals(q)))throw Error('snow view');await bot.lookAt(aim,true);await wait(1);await bot.dig(b,true,'raycast');await wait(2);return;}const tool=bot.inventory.items().find(i=>(['stone','granite','diorite','andesite','cobblestone','deepslate'].includes(b.name)||b.name.endsWith('_ore'))?i.name.endsWith('_pickaxe'):['dirt','grass_block','snow','sand'].includes(b.name)?i.name.endsWith('_shovel'):b.name.endsWith('_log')?i.name.endsWith('_axe'):false);if(tool)await bot.equip(tool,'hand');else await bot.unequip('hand');const f=await face(q);await bot.dig(b,'ignore',dirs[f.face]);await wait(2);if(!['air','cave_air'].includes(bot.blockAt(q)?.name))throw Error('digpost');console.log('CUT',JSON.stringify({q,n:b.name,p:bot.entity.position}));}
async function up(){const p=bot.entity.position.floored(),q=p.offset(0,-1,0);if(!bot.entity.onGround||!full(q))throw Error('UPsource');await cut(p.offset(0,2,0));await cut(p.offset(0,3,0));const item=['dirt','gravel','cobblestone','cobbled_deepslate','granite','diorite','andesite','spruce_planks'].map(n=>bot.inventory.items().find(i=>i.name===n)).find(Boolean);if(!item)throw Error('UPfund');await bot.equip(item,'hand');await bot.lookAt(q.offset(.5,1,.5),true);bot.setControlState('jump',true);try{for(let k=0;k<12;k++){await wait(1);if(bot.entity.position.y>=p.y+1.04){const c=bot.blockAtCursor(4.5);if(!c?.position.equals(q))throw Error('UPcursor');await bot.placeBlock(bot.blockAt(q),v(0,1,0));break;}}}finally{bot.setControlState('jump',false);}await wait(8);if(!bot.entity.onGround||Math.abs(bot.entity.position.y-(p.y+1))>.05)throw Error('UPpost');console.log('UP',JSON.stringify(state()));}
function stop(){bot.pathfinder.setGoal(null);bot.clearControlStates();}
async function walk(x,y,z,ms=12000,minHP=1){const m=new Movements(bot);m.canDig=false;m.allow1by1towers=false;m.allowParkour=false;m.allowSprinting=false;m.maxDropDown=2;m.scafoldingBlocks=[];for(const n of['water','lava','powder_snow'])if(bot.registry.blocksByName[n])m.blocksToAvoid.add(bot.registry.blocksByName[n].id);bot.pathfinder.setMovements(m);const g=new goals.GoalBlock(x,y,z);bot.pathfinder.setGoal(g);const t=Date.now();try{while(Date.now()-t<ms&&!g.isEnd(bot.entity.position.floored())){if(bot.health<minHP)throw Error('walkhealth');await wait(2);}}finally{stop();}await wait(3);if(!g.isEnd(bot.entity.position.floored())||!bot.entity.onGround)throw Error('walkpost '+JSON.stringify(state()));const target=v(x+.5,y,z+.5);for(let k=0;k<24&&Math.hypot(bot.entity.position.x-target.x,bot.entity.position.z-target.z)>.07;k++){await bot.lookAt(v(target.x,bot.entity.position.y-2,target.z),true);bot.setControlState('forward',true);await wait(1);stop();await wait(2);}if(Math.hypot(bot.entity.position.x-target.x,bot.entity.position.z-target.z)>.12)throw Error('walkcenter');console.log('WALK',JSON.stringify(state()));}
async function tidy(){if(bot.currentWindow)bot.closeWindow(bot.currentWindow);for(let k=1;k<=4;k++)if(bot.inventory.slots[k])await bot.putAway(k);await wait(2);if(bot.inventory.selectedItem){const e=Array.from({length:36},(_,i)=>i+9).find(i=>!bot.inventory.slots[i]);if(e===undefined)throw Error('cursorfull');await bot.clickWindow(e,0,0);await wait(2);}}
async function craft(n,k=1,table=null){await tidy();const r=bot.recipesFor(bot.registry.itemsByName[n].id,null,1,table)[0];if(!r)throw Error('recipe '+n);if(table)await face(table.position);await bot.craft(r,k,table);await wait(3);await tidy();console.log('CRAFT',n,k,JSON.stringify(state()));}
async function placeAt(q,n){if(!['air','cave_air'].includes(bot.blockAt(q)?.name))throw Error('placeoccupied '+q);const item=bot.inventory.items().find(i=>i.name===n);if(!item)throw Error('placefund '+n);for(const d of dirs){const ref=q.minus(d);if(!full(ref))continue;const aim=ref.offset(.5+d.x*.49,.5+d.y*.49,.5+d.z*.49),eye=bot.entity.position.offset(0,bot.entity.eyeHeight,0),delta=aim.minus(eye);if(delta.norm()>4.4)continue;const h=bot.world.raycast(eye,delta.scaled(1/delta.norm()),delta.norm()+.04);if(!h?.position.equals(ref))continue;await bot.lookAt(aim,true);await wait(1);const c=bot.blockAtCursor(4.5);if(!c?.position.equals(ref)||!dirs[c.face]?.equals(d))continue;await bot.equip(item,'hand');await bot.placeBlock(bot.blockAt(ref),d);await wait(2);if(bot.blockAt(q)?.name!==n)throw Error('placepost');return;}throw Error('placeface '+q);}
async function fightNearby(ms=6500){const t=Date.now();let last=0;while(Date.now()-t<ms&&bot.health>0){const p=bot.entity.position;const e=Object.values(bot.entities).filter(e=>['zombie','spider','skeleton'].includes(e.name)&&e.position.distanceTo(p)<5).sort((a,b)=>a.position.distanceTo(p)-b.position.distanceTo(p))[0];if(!e)break;const weapon=bot.inventory.items().find(i=>i.name==='stone_sword')||bot.inventory.items().find(i=>i.name==='wooden_sword');if(!weapon)throw Error('no sword for fight');await bot.equip(weapon,'hand');const eye=p.offset(0,bot.entity.eyeHeight,0),aim=e.position.offset(0,Math.min(1,e.height*.7),0),d=aim.minus(eye);if(e.position.distanceTo(p)<=3&&d.norm()<=3&&!bot.world.raycast(eye,d.scaled(1/d.norm()),d.norm()-.05)){await bot.lookAt(aim,true);if(Date.now()-last>600){bot.attack(e);last=Date.now();console.log('ORDINARY_HIT',JSON.stringify({at:new Date().toISOString(),n:e.name,id:e.id,p,ep:e.position,hp:bot.health}));}}await wait(2);}console.log('FIGHT_END',JSON.stringify(state()));}

function boundary(){const p=bot.entity.position.floored();return [p.offset(0,-1,0),p.offset(0,2,0),...[v(1,0,0),v(-1,0,0),v(0,0,1),v(0,0,-1)].flatMap(d=>[p.plus(d),p.plus(d).offset(0,1,0)])].map(q=>({q,n:bot.blockAt(q)?.name,full:full(q)}));}
async function bury(){stop();await wait(4);const s=bot.entity.position.floored(),ds=[v(1,0,0),v(-1,0,0),v(0,0,1),v(0,0,-1)],spots=[];const allowed=q=>full(q)&&!['sand','gravel','water','lava'].includes(bot.blockAt(q)?.name)&&!bot.blockAt(q)?.name.endsWith('_leaves');for(let dx=-6;dx<=6;dx++)for(let dz=-6;dz<=6;dz++)for(let dy=-3;dy<=2;dy++){const q=s.offset(dx,dy,dz);if(!['air','snow','short_grass'].includes(bot.blockAt(q)?.name)||bot.blockAt(q.offset(0,1,0))?.name!=='air')continue;if(![1,2,3,4].every(y=>allowed(q.offset(0,-y,0))))continue;if(!ds.every(d=>[1,2,3].every(y=>allowed(q.plus(d).offset(0,-y,0)))))continue;spots.push(q);}spots.sort((a,b)=>a.distanceTo(bot.entity.position)-b.distanceTo(bot.entity.position));if(!spots.length)throw Error('no natural3deep ending');let q=spots[0];console.log('BURY_ADMISSION',JSON.stringify({q,at:state()}));await walk(q.x,q.y,q.z,4500,1);const center=q.offset(.5,0,.5);for(let i=0;i<24&&Math.hypot(bot.entity.position.x-center.x,bot.entity.position.z-center.z)>.07;i++){await bot.lookAt(v(center.x,bot.entity.position.y-2,center.z),true);bot.setControlState('forward',true);await wait(1);stop();await wait(2);}if(Math.hypot(bot.entity.position.x-center.x,bot.entity.position.z-center.z)>.1)throw Error('centerpost');for(let k=0;k<3;k++){const p=bot.entity.position.floored();if(!full(p.offset(0,-2,0)))throw Error('support changed');await cut(p.offset(0,-1,0));await wait(7);if(!bot.entity.onGround||bot.entity.position.y!==q.y-k-1)throw Error('downpost');}await wait(8);await placeAt(bot.entity.position.floored().offset(0,2,0),bot.inventory.items().some(i=>i.name==='dirt')?'dirt':'cobblestone');for(let k=0;k<3;k++){const faces=boundary();console.log('ENDING',JSON.stringify({...state(),faces}));if(!faces.every(f=>f.full))throw Error('boundarypost');await wait(4);}return bot.entity.position.floored();}
function material(){const n=['dirt','cobblestone','cobbled_deepslate','granite','diorite','andesite','spruce_planks'].find(n=>bot.inventory.items().some(i=>i.name===n));if(!n)throw Error('box material exhausted');return n;}
async function makeBox(hint=null,open=false){
 const src=bot.entity.position.floored(),ds=[v(1,0,0),v(-1,0,0),v(0,0,1),v(0,0,-1)],spots=[];
 for(let x=-5;x<=5;x++)for(let z=-5;z<=5;z++)for(let y=-1;y<=1;y++){const p=src.offset(x,y,z);if(open&&full(p.offset(0,2,0)))continue;if(!full(p.offset(0,-1,0))||!['air','snow'].includes(bot.blockAt(p)?.name)||bot.blockAt(p.offset(0,1,0))?.name!=='air')continue;if(!ds.every(d=>{const q=p.plus(d);return full(q.offset(0,-1,0))&&(full(q)||['air','snow'].includes(bot.blockAt(q)?.name))&&(full(q.offset(0,1,0))||bot.blockAt(q.offset(0,1,0))?.name==='air');}))continue;spots.push(p);}
 spots.sort((a,b)=>(hint?a.distanceTo(hint)-b.distanceTo(hint):a.distanceTo(bot.entity.position)-b.distanceTo(bot.entity.position)));if(hint&&!spots.some(q=>q.equals(hint)))throw Error('tested box footprint changed');if(!spots.length)throw Error('no flat box footprint');const p=spots[0];await walk(p.x,p.y,p.z,6000);
 const target=p.offset(.5,0,.5);for(let k=0;k<20&&Math.hypot(bot.entity.position.x-target.x,bot.entity.position.z-target.z)>.06;k++){await bot.lookAt(v(target.x,bot.entity.position.y-2,target.z),true);bot.setControlState('forward',true);await wait(1);bot.setControlState('forward',false);await wait(2);}stop();
 async function snow(q){if(bot.blockAt(q)?.name!=='snow')return;const eye=bot.entity.position.offset(0,bot.entity.eyeHeight,0),aim=q.offset(.5,.1,.5),d=aim.minus(eye),h=bot.world.raycast(eye,d.scaled(1/d.norm()),d.norm()+.01);if(d.norm()>4.4||(h&&!h.position.equals(q)))throw Error('snow occluded');await bot.unequip('hand');await bot.lookAt(aim,true);await wait(1);await bot.dig(bot.blockAt(q),true,'raycast');await wait(2);}
 for(const d of ds){const q=p.plus(d);await snow(q);for(const y of[0,1]){if(bot.health<=0||!bot.entity.position.floored().equals(p))throw Error('box body changed');if(!full(q.offset(0,y,0)))await placeAt(q.offset(0,y,0),material());}}
 if(!full(p.offset(0,2,0))){
 let direct=false;try{await placeAt(p.offset(0,2,0),material());direct=true;}catch(e){console.log('NO_DIRECT_ROOF',String(e));}
 if(!direct){const ref=p.offset(1,1,0);await bot.equip(bot.inventory.items().find(i=>i.name===material()),'hand');bot.setControlState('jump',true);try{await wait(5);const c=await face(ref);if(c.face!==1)throw Error('actual roofanchor topface');await bot.placeBlock(bot.blockAt(ref),v(0,1,0));}finally{bot.setControlState('jump',false);}await wait(12);if(!bot.entity.onGround||bot.entity.position.y!==p.y)throw Error('roofanchor landing');await placeAt(p.offset(0,2,0),material());}
 }
 const qs=[p.offset(0,-1,0),p.offset(0,2,0),...ds.flatMap(d=>[p.plus(d),p.plus(d).offset(0,1,0)])];for(let k=0;k<3;k++){console.log('BOX_AUDIT',JSON.stringify({at:new Date().toISOString(),hp:bot.health,p:bot.entity.position,faces:qs.map(q=>({q,n:bot.blockAt(q)?.name,full:full(q)}))}));if(!qs.every(full))throw Error('box post');await wait(4);}return p;
}
async function carveRoom(){
 stop();await wait(3);const s=bot.entity.position.floored(),ds=[v(1,0,0),v(-1,0,0),v(0,0,1),v(0,0,-1)],options=[];
 const removable=q=>['stone','dirt','grass_block','cobblestone','andesite','diorite','granite','deepslate','air','cave_air'].includes(bot.blockAt(q)?.name);
 for(let dx=-5;dx<=5;dx++)for(let dz=-5;dz<=5;dz++)for(let dy=-1;dy<=2;dy++){
  const q=s.offset(dx,dy,dz);if(!full(q.offset(0,-1,0))||!full(q.offset(0,2,0))||['sand','gravel'].includes(bot.blockAt(q.offset(0,2,0))?.name)||!removable(q)||!removable(q.offset(0,1,0)))continue;
  if(!ds.every(d=>{const w=q.plus(d);return (full(w)||bot.blockAt(w)?.name==='air')&&(full(w.offset(0,1,0))||bot.blockAt(w.offset(0,1,0))?.name==='air')&&(full(w)||full(w.offset(0,-1,0)));}))continue;
  const names=['dirt','cobblestone','cobbled_deepslate','granite','diorite','andesite','spruce_planks'];const carried=bot.inventory.items().filter(i=>names.includes(i.name)).reduce((a,i)=>a+i.count,0),drops=[q,q.offset(0,1,0)].filter(w=>full(w)).length,need=ds.reduce((a,d)=>a+[q.plus(d),q.plus(d).offset(0,1,0)].filter(w=>!full(w)).length,0);if(carried+drops<need)continue;
