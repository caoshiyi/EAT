
async function gapDown(minY){mode='escape';stop();for(let n=0;n<25&&!life.onGround;n++)await tick();for(let n=0;n<40&&life.position.floored().y>minY;n++){const p=life.position.floored();let dest=p.y-1;while(dest>minY&&!full(V(p.x,dest-1,p.z)))dest--;if(dest<p.y-3||!full(V(p.x,dest-1,p.z)))throw Error('GAP_FLOOR_PRICE');await cut(p.offset(0,-1,0));for(let k=0;k<25;k++){await tick();if(life.onGround&&life.position.y<p.y-.8)break}if(!life.onGround||Math.abs(life.position.y-dest)>.12)throw Error('GAP_FALL_ACK');await put(life.position.floored().offset(0,2,0));trace.push(['GAP_DOWN_FULL',life.position.clone(),bot.health,dest]);}}
