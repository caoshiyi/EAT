try{if(bot.game.dimension!=='the_end'||!bot.entity.position.floored().equals(v(-11,50,-11))||bot.health!==10)throw Error('smallsource');console.log('SMALL_START',JSON.stringify(state()));await cut(v(-11,52,-11),['end_stone']);await guardedPillar('basalt');console.log('ONE_PILLAR_REAL',JSON.stringify(state()));guard.beginEscape('smallreturn');const q=guard.escapeFloor('actualfloor');await cut(q.position,[q.name]);await sleep(8);if(!bot.entity.onGround||Math.abs(bot.entity.position.y-50)>.03)throw Error('smalldownpost');await seal(true);console.log('SMALL_RETAINED',JSON.stringify(state()));}catch(e){console.log('FAILURE',String(e),JSON.stringify(state()));try{await sleep(15);await seal(true);}catch(f){console.log('RECOVERY_FAILURE',String(f));}}finally{console.log('OPERATION_GUARD',JSON.stringify(guard.report()));guard.close();stop();}return state();
