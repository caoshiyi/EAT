try{if(bot.game.dimension!=='the_end'||bot.health<=0)throw Error('wronglife');console.log('ACTUAL_PRE',JSON.stringify(state()));const a=bot.entity.position.floored(),center=a.offset(.5,0,.5);if(!full(a.offset(0,-2,0)))throw Error('recenterbottomsupport');await bot.lookAt(v(center.x,bot.entity.position.y+bot.entity.eyeHeight,center.z),true);bot.setControlState('forward',true);await sleep(2);bot.clearControlStates();await sleep(12);console.log('ACTUAL_AFTER_CENTER',JSON.stringify(state()));for(let k=0;k<3;k++){alive();const q=bot.entity.position.floored();if(!bot.entity.onGround||!full(q.offset(0,-2,0)))throw Error('actualsupport');await cut(q.offset(0,-1,0),['end_stone','basalt','blackstone']);await sleep(8);if(!bot.entity.onGround||Math.abs(bot.entity.position.y-q.y+1)>.03)throw Error('actualdrop');}await seal(true);console.log('ESCAPE_RETAINED',JSON.stringify(state()));}catch(e){console.log('FAILURE',String(e),JSON.stringify(state()));}finally{bot.clearControlStates();stop();}
const target=Object.values(bot.entities).find(e=>e.name==='end_crystal'&&e.position.x===-33.5&&e.position.z===-24.5);const candidates=[];
if(target)for(let x=-26;x<=-12;x+=2)for(let z=-24;z<=-6;z+=2){let top=null;for(let y=65;y>=40;y--)if(full(v(x,y-1,z))&&['air','cave_air'].includes(bot.blockAt(v(x,y,z))?.name)){top=y;break;}if(top===null)continue;for(const extra of[0,1]){const feet=v(x+.5,top+extra,z+.5),eye=feet.offset(0,bot.entity.eyeHeight,0),point=target.position.offset(.9,1.8,.9),d=point.minus(eye),hit=bot.world.raycast(eye,d.scaled(1/d.norm()),d.norm()-.02);candidates.push({feet,extra,groundFootY:top,targetVisiblePoint:point,futureRayClear:!hit,hit:hit?{p:hit.position,name:hit.name}:null});}}
console.log('SURFACE_GEOMETRY_MODEL',JSON.stringify({at:new Date().toISOString(),target:target?{id:target.id,p:target.position,width:target.width,height:target.height}:null,candidates,note:'Loaded public block/entity geometry only; future rays do not admit action; no trajectory/safety claim'}));return state();
