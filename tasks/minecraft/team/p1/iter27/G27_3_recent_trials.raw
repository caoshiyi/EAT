let trace=null;try{if(bot.game.dimension!=='the_end'||Math.abs(bot.entity.position.y-50)>.03||bot.health!==10||count('snowball')!==4)throw Error('resume source');for(let k=0;k<15;k++){const a=bot.entity.position.floored();if(a.z!==-11||a.x>0||a.x< -11)throw Error('resume bounds');if(a.x===-11)break;await stepCovered(-1,0);}await seal(true);trace=makeHazardRecorder(bot);for(let k=0;k<120;k++){alive();if(bot.health<10)throw Error('deepwatchdamage');await sleep(5);}await seal(true);console.log('DEEP_WATCH_RETAINED',JSON.stringify(state()));}catch(e){console.log('FAILURE',String(e),JSON.stringify(state()));try{await seal(true);}catch(f){console.log('RECOVERY_FAILURE',String(f));}}finally{if(trace)console.log('HAZARD_TRACE',JSON.stringify(trace.stop()));stop();}return state();
