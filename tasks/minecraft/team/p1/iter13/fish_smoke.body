try{const p=bot.entity.position.floored();if(!p.equals(V([165,-40,2257])))throw Error('START');if(threat())throw Error('THREAT');await clear(p.offset(1,1,0));await bot.equip(bot.inventory.items().find(i=>i.name==='stone_brick_slab'),'hand');await bot.placeBlock(bot.blockAt(p.offset(1,2,0)),V([0,-1,0]));await tick(4);console.log('APERTURE_HEAD',bot.blockAt(p.offset(1,1,0))?.getProperties());if(bot.blockAt(p.offset(1,1,0))?.getProperties().type!=='top')throw Error('SLAB_TOP');await clear(p.offset(1,0,0));await bot.equip(bot.inventory.items().find(i=>i.name==='fishing_rod'),'hand');await bot.lookAt(V([167.5,-40.2,2257.5]),true);let done=false,err=null;const task=bot.fish().then(()=>{done=true}).catch(e=>{err=e.message;done=true});await tick(50);console.log('BOBBER_ACTUAL',Object.values(bot.entities).filter(e=>e.name?.includes('bobber')).map(e=>[e.id,e.name,e.position,bot.blockAt(e.position.floored())?.name,e.velocity]));if(!done)bot.activateItem();await tick(10);console.log('FISH_SMOKE',JSON.stringify({done,err,fish:bot.inventory.items().filter(i=>['cod','salmon','pufferfish','tropical_fish'].includes(i.name)).map(i=>[i.name,i.count]),hp:bot.health}));
