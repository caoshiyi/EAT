try{if(!bot.entity.position.floored().equals(V([-19,65,48])))throw Error('START');if(count('spruce_planks')!==1||count('warped_planks')!==1)throw Error('FOUND_PLANKS');const q=V([-18,66,48]);if(bot.blockAt(q)?.name!=='basalt')throw Error('OWN_HEAD_KIND');await clear(q);await bot.equip(bot.inventory.items().find(i=>i.name==='crafting_table'),'hand');await bot.placeBlock(bot.blockAt(q.offset(0,-1,0)),V([0,1,0]));await tick(3);async function craft(n,t){let r=bot.recipesFor(bot.registry.itemsByName[n].id,null,1,t)[0];if(!r)throw Error('RECIPE_'+n);await bot.craft(r,1,t);if(bot.currentWindow)bot.closeWindow(bot.currentWindow);await tick(4);console.log('FOUND_SOURCE_CRAFT',n,count(n))}await craft('stick',null);if(count('stick')!==4)throw Error('STICKS');await craft('stone_pickaxe',bot.blockAt(q));if(count('stone_pickaxe')!==4)throw Error('PICK_RECEIPT');await bot.unequip('hand');await bot.dig(bot.blockAt(q),true);await tick(25);if(count('crafting_table')!==1)throw Error('TABLE_RECOVERY');await put(q);
