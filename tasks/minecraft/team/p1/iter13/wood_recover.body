try{const p=bot.entity.position.floored();if(!p.equals(V([141,-36,2240])))throw Error('START');if(threat())throw Error('THREAT');const qs=[V([141,-34,2240]),V([141,-34,2241])];for(let q of qs)await clear(q);await tick(20);console.log('WOOD_RECOVERED',count('oak_planks'));for(let q of qs)await put(q);if(count('oak_planks')<6)throw Error('WOOD_RECEIPT');async function craft(n){let r=bot.recipesFor(bot.registry.itemsByName[n].id,null,1,null)[0];if(!r)throw Error('RECIPE_'+n);await bot.craft(r,1,null);await tick(3);console.log('CRAFT_ACTUAL',n,count(n))}await craft('crafting_table');await craft('stick');
