try{const p=bot.entity.position.floored();if(!p.equals(V([9,68,82]))||!global.P1BankSmoke13?.pass)throw Error('SMOKE_OR_POSE');for(let y of[1,0])await clear(V([8,68+y,82]));await tick(15);const c=await bot.openChest(bot.blockAt(V([7,68,82]))),trace=[];try{const sum=(xs,n)=>xs.filter(i=>i.name===n).reduce((s,i)=>s+i.count,0),own=()=>c.slots.slice(c.inventoryStart,c.inventoryEnd).filter(Boolean);if(c.selectedItem)throw Error('CURSOR');const swords=own().filter(i=>i.name==='iron_sword').map(i=>i.durabilityUsed).sort((a,b)=>a-b);if(swords.join(',')!=='24,46')throw Error('SWORD_SOURCE_'+swords);for(let[n,k]of[['blackstone',9],['iron_sword',2],['crafting_table',1],['basalt',19],['oak_planks',1],['stick',2],['gold_ingot',1]]){const b=sum(c.containerItems(),n),o=sum(own(),n);if(o<k)throw Error('SOURCE_SHORT_'+n);await c.deposit(bot.registry.itemsByName[n].id,null,k);await tick(4);const a=sum(c.containerItems(),n),o1=sum(own(),n);trace.push({name:n,count:k,bankBefore:b,bankAfter:a,ownBefore:o,ownAfter:o1,cursor:c.selectedItem??null});console.log('ITEM_BANK_ACTUAL',JSON.stringify(trace[trace.length-1]));if(a-b!==k||o-o1!==k||c.selectedItem)throw Error('TRANSFER_'+n)}const bank=c.containerItems().map(i=>[i.name,i.count,i.durabilityUsed]);console.log('PACKET_BANK_ACTUAL',JSON.stringify({trace,bank,earlierBasalt:2}));global.P1Packet13={pass:true,at:Date.now(),trace,bank,basaltTotal:21};}finally{if(c.selectedItem){const slot=c.slots.findIndex((i,k)=>!i&&k>=c.inventoryStart&&k<c.inventoryEnd);if(slot>=0)await bot.clickWindow(slot,0,0)}await c.close()}
