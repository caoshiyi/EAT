try{const p=bot.entity.position.floored(),bank=V([7,68,82]);if(!p.equals(V([9,68,82])))throw Error('START');if(threat())throw Error('THREAT');for(let y of[1,0])await clear(V([8,68+y,82]));const eye=bot.entity.position.offset(0,1.62,0),d=bank.offset(.5,.5,.5).minus(eye),hit=bot.world.raycast(eye,d.unit(),d.norm()+.2);console.log('BANK_REACH',d.norm(),hit&&[hit.name,hit.position]);if(hit?.name!=='chest'||!hit.position.equals(bank))throw Error('BANK_LOS');let c=await bot.openChest(bot.blockAt(bank));try{const sum=(xs,n)=>xs.filter(i=>i.name===n).reduce((s,i)=>s+i.count,0),own0=count('basalt'),before=sum(c.containerItems(),'basalt');if(c.selectedItem)throw Error('CURSOR');await c.deposit(bot.registry.itemsByName.basalt.id,null,1);await tick(5);const after=sum(c.containerItems(),'basalt'),own1=count('basalt');console.log('BANK_SMOKE_ACTUAL',JSON.stringify({before,after,own0,own1,cursor:c.selectedItem??null,bank:c.containerItems().map(i=>[i.name,i.count,i.durabilityUsed])}));if(after-before!==1||own0-own1!==1||c.selectedItem)throw Error('TRANSFER_RECEIPT');global.P1BankSmoke13={pass:true,at:Date.now(),basaltDeposited:1}}finally{await c.close()}
