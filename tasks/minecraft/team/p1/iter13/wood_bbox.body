try{const p=bot.entity.position.floored();if(!p.equals(V([141,-36,2240])))throw Error('START');if(threat())throw Error('THREAT');const drop=Object.values(bot.entities).find(e=>e.name==='item'&&e.getDroppedItem?.()?.name==='oak_planks'&&e.position.distanceTo(bot.entity.position)<5);if(!drop)throw Error('DROP_GONE');console.log('DROP_ACTUAL',drop.id,drop.position);let qs=[];for(let x=Math.floor(drop.position.x-.125);x<=Math.floor(drop.position.x+.125);x++)for(let z=Math.floor(drop.position.z-.125);z<=Math.floor(drop.position.z+.125);z++){let q=V([x,Math.floor(drop.position.y)-1,z]);if(q.y!==-34||!['basalt','blackstone','bookshelf'].includes(bot.blockAt(q)?.name))throw Error('SUPPORT_KIND_'+q);qs.push(q)}console.log('BBOX_SUPPORT',qs);for(let q of qs)await clear(q);await tick(25);console.log('WOOD_RECOVERED',count('oak_planks'));for(let q of qs)await put(q);if(count('oak_planks')<6)throw Error('WOOD_RECEIPT');async function craft(n){let r=bot.recipesFor(bot.registry.itemsByName[n].id,null,1,null)[0];if(!r)throw Error('RECIPE_'+n);await bot.craft(r,1,null);await tick(3);console.log('CRAFT_ACTUAL',n,count(n))}await craft('crafting_table');await craft('stick');
