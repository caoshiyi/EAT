try{const p=bot.entity.position.floored(),q=V([163,-26,2231]);if(!p.equals(V([163,-26,2232])))throw Error('START');if(threat())throw Error('THREAT');for(let x of[162,164])for(let y of[-26,-25])await put(V([x,y,2231]));await put(V([164,-24,2231]));await put(V([163,-24,2231]));await move(q);for(let x of[163,164])for(let y of[-26,-25,-24])await put(V([x,y,2229]));const bottom=V([163,-27,2230]);if(bot.blockAt(bottom)?.name!=='obsidian')throw Error('OBSIDIAN_GONE');await bot.equip(bot.inventory.items().find(i=>i.name==='flint_and_steel'),'hand');await bot.activateBlock(bot.blockAt(bottom),V([0,1,0]),V([.5,1,.5]));await tick(8);let portals=[];for(let x of[163,164])for(let y of[-26,-25,-24])portals.push([x,y,2230,bot.blockAt(V([x,y,2230]))?.name]);console.log('RELIGHT_WORLD_ACTUAL',JSON.stringify(portals));if(!portals.every(c=>c[3]==='nether_portal'))throw Error('IGNITION_NOT_COMPLETE');await move(p);
