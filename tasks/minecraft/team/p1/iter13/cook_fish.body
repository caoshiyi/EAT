try{const p=bot.entity.position.floored();if(!p.equals(V([165,-40,2257])))throw Error('START');const raw=bot.inventory.items().find(i=>['cod','salmon'].includes(i.name));if(!raw)throw Error('NO_EDIBLE_FISH');const q=p.offset(0,1,1);await clear(q);await bot.equip(bot.inventory.items().find(i=>i.name==='furnace'),'hand');await bot.placeBlock(bot.blockAt(q.offset(0,-1,0)),V([0,1,0]));await tick(4);if(bot.blockAt(q)?.name!=='furnace')throw Error('FURNACE_ACK');const f=await bot.openFurnace(bot.blockAt(q));try{await f.putInput(raw.type,null,1);const fuel=bot.inventory.items().find(i=>i.name==='ladder');if(!fuel)throw Error('NO_FUEL');await f.putFuel(fuel.type,null,1);for(let n=0;n<270&&!f.outputItem();n++)await tick(1);console.log('FURNACE_OUTPUT',f.outputItem()?.name,f.outputItem()?.count);if(!f.outputItem())throw Error('COOK_TIMEOUT');await f.takeOutput()}finally{f.close()}await tick(5);let cooked=bot.inventory.items().find(i=>['cooked_cod','cooked_salmon'].includes(i.name));if(!cooked)throw Error('COOK_RECEIPT');await bot.equip(cooked,'hand');await bot.consume();await tick(60);console.log('EAT_ACTUAL',bot.health,bot.food);
