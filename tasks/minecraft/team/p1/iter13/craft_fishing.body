try{const p=bot.entity.position.floored(),q=p.offset(0,2,0);if(!p.equals(V([141,-36,2240])))throw Error('START');if(threat())throw Error('THREAT');await clear(q);await bot.equip(bot.inventory.items().find(i=>i.name==='crafting_table'),'hand');await bot.placeBlock(bot.blockAt(q.offset(1,0,0)),V([-1,0,0]));await tick(4);if(bot.blockAt(q)?.name!=='crafting_table')throw Error('TABLE_ACK');for(let n of['fishing_rod','furnace']){let r=bot.recipesFor(bot.registry.itemsByName[n].id,null,1,bot.blockAt(q))[0];if(!r)throw Error('RECIPE_'+n);await bot.craft(r,1,bot.blockAt(q));await tick(5);console.log('CRAFT_RECEIPT',n,count(n))}await bot.equip(bot.inventory.items().find(i=>i.name==='iron_pickaxe'),'hand');await bot.dig(bot.blockAt(q),true);await tick(30);console.log('TABLE_RECOVERY',count('crafting_table'));await put(q);
