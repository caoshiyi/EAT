try{const p=bot.entity.position.floored();if(!p.equals(V([166,-38,2234])))throw Error('START');const q=p.offset(1,1,0);await put(p.offset(1,2,0));if(!full(p.offset(1,0,0)))throw Error('FOOT_GUARD');let e=bot.entities[19898];if(!e||e.name!=='zombie'||e.position.distanceTo(bot.entity.position)>7)throw Error('TARGET_CHANGED');let dead=false,swings=0,trace=[];const died=e=>{if(e.id===19898)dead=true};bot.on('entityDead',died);try{await clear(q);await bot.equip(bot.inventory.items().find(i=>i.name==='stone_sword'),'hand');await tick(13);for(let n=0;n<180&&!dead;n++){if(bot.health<17)throw Error('HEALTH_BUDGET');e=bot.entities[19898];if(!e)break;const eye=bot.entity.position.offset(0,1.62,0),target=e.position.offset(0,1,0),d=target.minus(eye);if(d.norm()<2.95&&!bot.world.raycast(eye,d.unit(),Math.max(.01,d.norm()-.2))){if(swings>=6)throw Error('SWING_BUDGET');await bot.lookAt(target,true);await tick(2);trace.push([e.id,e.metadata?.[9],e.position.clone()]);bot.attack(e);swings++;await tick(13)}else await tick(1)}console.log('ZOMBIE_CONTACT_ACTUAL',JSON.stringify({dead,swings,trace,hp:bot.health,target:bot.entities[19898]&&[bot.entities[19898].position,bot.entities[19898].metadata?.[9]],drops:Object.values(bot.entities).filter(e=>e.name==='item'&&e.position.distanceTo(bot.entity.position)<5).map(e=>[e.id,e.position,e.getDroppedItem?.()?.name])}));}finally{bot.removeListener('entityDead',died);await put(q)}
