try{const p=bot.entity.position.floored();if(!p.equals(V([141,-36,2240])))throw Error('START');if(threat())throw Error('THREAT');const woods=[V([141,-32,2240]),V([140,-32,2240])];if(!woods.every(q=>bot.blockAt(q)?.name==='oak_planks'))throw Error('SOURCE');for(let q of woods)await put(q.offset(0,1,0));await clear(p.offset(0,2,0));for(let q of woods)await clear(q);await tick(25);await put(p.offset(0,2,0));console.log('WOOD_ACTUAL',count('oak_planks'));if(count('oak_planks')<6)throw Error('WOOD_PICKUP_SHORT');async function craft(n,t=null){const r=bot.recipesFor(bot.registry.itemsByName[n].id,null,1,t)[0];if(!r)throw Error('RECIPE_'+n);await bot.craft(r,1,t);await tick(3);console.log('CRAFT_ACTUAL',n,count(n))}await craft('crafting_table');await craft('stick');
