try{if(!bot.entity.position.floored().equals(V([-19,65,48])))throw Error('START');const t=V([-18,66,48]);if(bot.blockAt(t)?.name!=='crafting_table'||bot.currentWindow)throw Error('TABLE_OR_WINDOW');if(bot.inventory.selectedItem||bot.inventory.slots.slice(0,5).some(Boolean))throw Error('GRID_NOT_EMPTY');for(let[n,to]of[['warped_planks',1],['spruce_planks',3]]){const item=bot.inventory.items().find(i=>i.name===n&&i.count===1);if(!item)throw Error('PLANK_SOURCE_'+n);await bot.clickWindow(item.slot,0,0);await bot.clickWindow(to,0,0);await tick(3)}await tick(5);console.log('MANUAL_OUTPUT_ACTUAL',bot.inventory.slots[0]?.name,bot.inventory.slots[0]?.count);if(bot.inventory.slots[0]?.name!=='stick'||bot.inventory.slots[0]?.count!==4)throw Error('MIXED_OUTPUT');await bot.clickWindow(0,0,1);await tick(5);if(count('stick')!==4||bot.inventory.selectedItem||bot.inventory.slots.slice(0,5).some(Boolean))throw Error('MIXED_RECEIPT');const r=bot.recipesFor(bot.registry.itemsByName.stone_pickaxe.id,null,1,bot.blockAt(t))[0];if(!r)throw Error('PICK_RECIPE');await bot.craft(r,1,bot.blockAt(t));if(bot.currentWindow)bot.closeWindow(bot.currentWindow);await tick(5);console.log('PICK_ACTUAL',count('stone_pickaxe'));if(count('stone_pickaxe')!==4)throw Error('PICK_RECEIPT');await bot.unequip('hand');await bot.dig(bot.blockAt(t),true);await tick(25);if(count('crafting_table')!==1)throw Error('TABLE_PICKUP');await put(t);
