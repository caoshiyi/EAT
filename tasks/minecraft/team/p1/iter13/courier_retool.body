try{const p=bot.entity.position.floored();if(!p.equals(V([144,-36,2241])))throw Error('START');if(threat())throw Error('THREAT');const woods=[-33,-34,-35,-36].map(y=>V([145,y,2241]));if(!woods.every(q=>bot.blockAt(q)?.name==='oak_planks'))throw Error('WOOD_SOURCE');await bot.unequip('hand');for(let q of woods){await bot.dig(bot.blockAt(q),true);await tick(3)}await tick(20);console.log('WOOD_ORDINARY',count('oak_planks'));for(let q of woods.slice().reverse())await put(q);if(count('oak_planks')<4)throw Error('WOOD_SHORT');const q=p.offset(0,2,0);await clear(q);await bot.equip(bot.inventory.items().find(i=>i.name==='crafting_table'),'hand');await bot.placeBlock(bot.blockAt(q.offset(1,0,0)),V([-1,0,0]));await tick(3);if(bot.blockAt(q)?.name!=='crafting_table')throw Error('TABLE_ACK');async function craft(n,t){let r=bot.recipesFor(bot.registry.itemsByName[n].id,null,1,t)[0];if(!r)throw Error('RECIPE_'+n);await bot.craft(r,1,t);if(bot.currentWindow)bot.closeWindow(bot.currentWindow);await tick(5);console.log('CRAFT_ACTUAL',n,count(n))}for(let i=0;i<2;i++)await craft('stick',null);if(count('stick')!==9)throw Error('STICK_RECEIPT_'+count('stick'));for(let i=0;i<3;i++)await craft('stone_pickaxe',bot.blockAt(q));if(count('stone_pickaxe')!==3)throw Error('PICK_RECEIPT');await bot.unequip('hand');await bot.dig(bot.blockAt(q),true);await tick(25);console.log('TABLE_RECOVERED',count('crafting_table'));await put(q);
