try{if(!bot.entity.position.floored().equals(V([9,68,82])))throw Error('START');for(let y of[1,0])await clear(V([8,68+y,82]));await tick(15);const c=await bot.openChest(bot.blockAt(V([7,68,82])));try{const sum=(a,n)=>a.filter(i=>i.name===n).reduce((s,i)=>s+i.count,0),own=()=>c.slots.slice(c.inventoryStart,c.inventoryEnd).filter(Boolean);for(let[n,k]of[['arrow',5],['coal',1]]){const b=sum(c.containerItems(),n),o=sum(own(),n);if(b<k)throw Error('BANK_SOURCE_'+n);await c.withdraw(bot.registry.itemsByName[n].id,null,k);await tick(4);const a=sum(c.containerItems(),n),o1=sum(own(),n);console.log('WITHDRAW_ACTUAL',JSON.stringify({n,k,b,a,o,o1,cursor:c.selectedItem??null}));if(b-a!==k||o1-o!==k||c.selectedItem)throw Error('WITHDRAW_'+n)}}finally{await c.close()}for(let y of[0,1])await put(V([8,68+y,82]));const recipe=bot.recipesFor(bot.registry.itemsByName.torch.id,null,1,null)[0];if(!recipe)throw Error('TORCH_RECIPE');await bot.craft(recipe,1,null);await tick(5);if(count('torch')!==4)throw Error('TORCH_RECEIPT');for(let z of[83,84,85]){let q=V([9,68,z]);await move(q);if(z===83){await bot.equip(bot.inventory.items().find(i=>i.name==='torch'),'hand');await bot.placeBlock(bot.blockAt(q.offset(1,1,0)),V([-1,0,0]));await tick(3);console.log('LANDING_LIGHT',bot.blockAt(q.offset(0,1,0))?.name)}}for(let y of[68,69])await put(V([9,y,82]));const q=bot.entity.position.floored();await bot.equip(bot.inventory.items().find(i=>i.name==='torch'),'hand');await bot.placeBlock(bot.blockAt(q.offset(1,1,0)),V([-1,0,0]));await tick(3);console.log('HALL_LIGHT',bot.blockAt(q.offset(0,1,0))?.name);global.P1BankDepart13={pass:true,oldBankBody:[68,69].map(y=>bot.blockAt(V([9,y,82]))?.name),arrow:count('arrow'),coal:count('coal'),torch:count('torch')};
