try{const p=bot.entity.position.floored();if(!p.equals(V([165,-40,2257])))throw Error('START');const structure=global.P1FishPool13?.structure;if(!structure||!structure.every(q=>full(V(q))))throw Error('POOL_CHANGED');if(bot.blockAt(V([167,-41,2257]))?.name!=='water')throw Error('WATER_GONE');if(threat())throw Error('THREAT');await clear(p.offset(1,1,0));await clear(p.offset(1,0,0));await bot.equip(bot.inventory.items().find(i=>i.name==='fishing_rod'),'hand');await bot.lookAt(V([167.5,-39.6,2257.5]),true);await tick(3);let done=false,err=null,trace=[];const hp0=bot.health;bot.fish().then(()=>done=true).catch(e=>{err=e.message;done=true});for(let n=0;n<1500&&!done;n++){await tick(1);if(bot.health<hp0-.1)throw Error('FISH_DAMAGE');if(threat())throw Error('FISH_THREAT');if(n%200===0)trace.push([n,Object.values(bot.entities).filter(e=>e.name?.includes('bobber')).map(e=>[e.position.clone(),bot.blockAt(e.position.floored())?.name])])}if(!done)bot.activateItem();await tick(30);console.log('CATCH_ACTUAL',JSON.stringify({done,err,trace,fish:bot.inventory.items().filter(i=>['cod','salmon','pufferfish','tropical_fish'].includes(i.name)).map(i=>[i.name,i.count]),drops:Object.values(bot.entities).filter(e=>e.name==='item'&&e.position.distanceTo(bot.entity.position)<6).map(e=>[e.id,e.position,e.getDroppedItem?.()?.name]),hp:bot.health,food:bot.food}));
