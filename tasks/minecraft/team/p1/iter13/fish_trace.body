try{const p=bot.entity.position.floored();if(!p.equals(V([165,-40,2257])))throw Error('START');if(threat())throw Error('THREAT');await clear(p.offset(1,1,0));await clear(p.offset(1,0,0));if(threat())throw Error('WINDOW_THREAT');await bot.equip(bot.inventory.items().find(i=>i.name==='fishing_rod'),'hand');await bot.lookAt(V([167.5,-39.6,2257.5]),true);await tick(3);let done=false,err=null;const task=bot.fish().then(()=>{done=true}).catch(e=>{err=e.message;done=true});let trace=[];for(let n=0;n<35;n++){await tick(1);let bs=Object.values(bot.entities).filter(e=>e.name?.includes('bobber'));trace.push([n,bs.map(e=>[e.id,e.position.clone(),bot.blockAt(e.position.floored())?.name])]);if(threat())throw Error('FISH_THREAT')}console.log('CAST_TRACE_ACTUAL',JSON.stringify({yaw:bot.entity.yaw,pitch:bot.entity.pitch,trace}));if(!done)bot.activateItem();await tick(8);console.log('FISH_END',done,err);
